# Neon PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.neon.tech/lucid?ssl=require

# Google OAuth Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# true: public Google or username/password signup; false: administrator approval
ALLOW_PUBLIC_SIGNUP=true
APPROVED_RECRUITER_EMAILS=[]

# Username signup Gmail verification (use a dedicated sender App Password).
# Store real sender credentials only in the ignored .env or host secrets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_FROM_EMAIL=
SMTP_PASSWORD=

# Google Drive service account key file path
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# JWT secret — change this to a random string in production
JWT_SECRET=change-me-to-a-random-secret

# CORS origins (comma-separated for multiple)
ALLOWED_ORIGINS=["http://localhost:5173"]

# Intake queue: one active assessment across the deployment
ASSESSMENT_WORKER_ENABLED=true
ASSESSMENT_POLL_SECONDS=2
ASSESSMENT_FILE_TIMEOUT_SECONDS=60
ASSESSMENT_MAX_FILES=100
